# Copy to .env and fill in. Never commit .env.

ENV=dev
DATABASE_URL=postgresql+asyncpg://aidev:aidev@localhost:5432/aidev
REDIS_URL=redis://localhost:6379/0

# Host ports for docker compose (change if 5432/6379 are already taken)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Needed from Phase 1 onward (https://www.voyageai.com) - embeddings + reranker
VOYAGE_API_KEY=
# Client-side pacing. Defaults match accounts without a payment method (3 RPM, 10K TPM),
# where embedding the whole index takes ~2.5 h. With a payment method on file (free
# tokens still apply) use e.g. VOYAGE_RPM=1000 and VOYAGE_TPM=1000000.
# VOYAGE_RPM=3
# VOYAGE_TPM=10000

# Needed from Phase 2 onward (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# dev: Haiku 5.5 for every role. final: bigger models for the reasoning roles and coder.
# LLM_PROFILE=dev

# Hard monthly spend caps, checked before every paid call (ADR 013).
# `uv run python -m aidev.llm usage` shows month-to-date spend.
# ANTHROPIC_MONTHLY_USD_CAP=5
# VOYAGE_MONTHLY_TOKEN_CAP=30000000
