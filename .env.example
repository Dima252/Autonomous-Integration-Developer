# Copy to .env and fill in. Never commit .env.

ENV=dev
DATABASE_URL=postgresql+asyncpg://aidev:aidev@localhost:5432/aidev
REDIS_URL=redis://localhost:6379/0

# Host ports for docker compose (change if 5432/6379 are already taken)
POSTGRES_PORT=5432
REDIS_PORT=6379

# Needed from Phase 1 onward (https://www.voyageai.com) - embeddings + reranker
VOYAGE_API_KEY=

# Needed from Phase 2 onward (https://console.anthropic.com)
ANTHROPIC_API_KEY=
