# Copy to /opt/aidev/.env on the VM and fill in. It never leaves the VM: CD doesn't
# touch it, and no secret here is stored in GitHub.

# Hostname Caddy serves and gets a certificate for. Without a domain, use the static IP
# through sslip.io, with dashes: 203.0.113.7 -> 203-0-113-7.sslip.io
SITE_ADDRESS=

# openssl rand -hex 24
POSTGRES_PASSWORD=

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Hard monthly spend caps (ADR 013). The demo is public, so keep these low.
ANTHROPIC_MONTHLY_USD_CAP=5
# VOYAGE_MONTHLY_TOKEN_CAP=30000000
# CHAT_RATE_LIMIT_PER_MINUTE=20

# Set by deploy.sh on every rollout; images default to the latest main build.
# IMAGE_TAG=latest
# IMAGE_REPO=ghcr.io/dima252/aidev
